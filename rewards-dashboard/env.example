# Rewards 管理面板：复制为 .env 后修改。
# `npm start` 会自动加载 .env 文件（--env-file-if-exists）。

# --- 必填配置 ---------------------------------------------------------------

# 脚本控制 API（scripts/api/server.js）的监听地址。
#   位于同一 Docker 网络  ->  http://microsoft-rewards-script:3010
#   控制 API 位于宿主机   ->  http://host.docker.internal:3010
#   两者在同一台机器运行  ->  http://127.0.0.1:3010
CONTROL_API_URL=http://127.0.0.1:3010

# 此令牌仅用于面板连接控制 API，必须与控制 API 的 API_TOKEN 完全一致。
# 仅在控制 API 也未设置 API_TOKEN 时才可留空。
CONTROL_API_TOKEN=

# 可选的浏览器登录保护。仅当用户名和密码都非空时启用认证。
# 任意一项留空时，访问面板不会弹出登录提示。
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# --- 可选配置 ---------------------------------------------------------------

# 面板监听端口。
PORT=8890

# 用于按日期归档积分及计算 Cron 定时任务的时区。
# 请正确设置，否则每日积分条形图会在错误的时间切换日期。
TZ=Europe/Amsterdam

# 页面顶部显示的标题。
DASHBOARD_TITLE=Microsoft Rewards

# API 状态轮询间隔（毫秒）。日志通过流式连接接收，
# 因此无需为日志设置过短的轮询间隔。
POLL_MS=5000

# 流式连接建立时向 API 请求的历史日志行数。
LOG_REPLAY=300

# dashboard.sqlite 所在目录，也是面板唯一写入数据的目录：
# 积分历史、运行记录、活动和定时任务均保存在其中。
# 脚本控制 API 本身不保存状态或文件。
DATA_DIR=./data

# --- 控制 API 端的配置说明 ---------------------------------------------------
# 以下功能依赖控制 API 端的开关，请在脚本端设置，而非此文件中：
#   API_ALLOW_CONFIG_WRITE=true   -> 配置页面允许保存（否则为只读）
#   API_ALLOW_CONFIG_REVEAL=true  -> 配置页面允许显示 Webhook 敏感信息
